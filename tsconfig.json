{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["chrome", "node", "vitest/globals"],
    "paths": {
      "holocene-timestamp-parser": ["./packages/holocene-timestamp-parser/src/index.ts"]
    }
  },
  "include": [
    "packages/extension-chrome-legacy/src/**/*.ts",
    "packages/extension-chrome-legacy/test/**/*.ts",
    "packages/holocene-timestamp-parser/src/**/*.ts",
    "packages/holocene-timestamp-parser/test/**/*.ts",
    "test/**/*.ts",
    "e2e/**/*.ts",
    "*.config.ts",
    "*.config.mts"
  ]
}
